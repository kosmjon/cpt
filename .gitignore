# Rust build artifacts
/mol80asm/target/
target/
**/*.rs.bk

# Assembler output
*.bin

# Generated disk images for the CP/M work (rebuilt by cpm/mkdisk.mjs)
cpm/*.img

# wasm build artifact copied into the web dir (rebuilt from source)
crates/cpt-wasm/web/*.wasm
# the sample program disk run-web.bat copies next to the page (decoded from cpt2489.td0)
crates/cpt-wasm/web/cpt2489.img

# Python bytecode from the tools
__pycache__/
*.pyc
# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# Generated CP/M build outputs (rebuilt by cpm/build-cpm.ps1)
cpm/build/
/target-verify/

# Generated audio from the speaker demo
speaker/*.wav

# PL/M-80 toolchain download and build output for monitor/monitor.plm
monitor/plm80tools/
monitor/plm-build/

# Disk images decoded from the TeleDisk files (rebuilt by setup-disks.bat / tools/setup_disks.py)
disk/
